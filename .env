# Shared simulation configuration for Docker Compose.

# TickGen
TICKGEN_HOST=0.0.0.0
TICKGEN_DISCOVERY_URL=opc.tcp://tickgen:4840/AdaptiveEnergySystem/TickGen
TICKGEN_START_TICKS=96
TICKGEN_START_DELAY_SECONDS=5
TICKGEN_TICK_INTERVAL_SECONDS=1
TICKGEN_START_TIME=2026-01-01T08:00:00Z

# Deferrable washing machine
DL_HOST=0.0.0.0
DL_DISCOVERY_URL=opc.tcp://dl:4842/AdaptiveEnergySystem/DeferrableLoad

# Shared OPC UA endpoint used by the machine and the example subscriber
TICKGEN_URL=opc.tcp://tickgen:4840/AdaptiveEnergySystem/TickGen

# Logging
RUST_LOG=info,opcua=warn
